<%- include('./partials/header.ejs') %>
<div class="container-fluid bg-dark text-white">
  <div class="row">
    <div class="col-sm-2">
      <%- include('./partials/sidebar.ejs') %>
    </div>

    <div class="col-sm-10">
      <!-- Main Content -->
      <div class="container mt-5">
        <h1 class="text-warning mb-5 border-bottom">CONTACT ME</h1>

        <div class="row text-white mb-5">
          <p class="mx-auto mb-5 text-center">
            Do you have any questions? Please do not hesitate to contact me.
            I will get back to you within a few hours to help you.
          </p>

          <!-- 🟢 Contact Form -->
          <div class="col-sm-9 mb-5">
            <form id="contactForm" action="https://formspree.io/f/xkgqoqyo" method="POST">
              <div class="row g-3">
                <div class="col-md-6">
                  <label for="inputName">Your Name</label>
                  <input type="text" class="form-control mt-2" id="inputName" name="name" required>
                </div>

                <div class="col-md-6">
                  <label for="inputEmail">Your Email *</label>
                  <input type="email" class="form-control mt-2" id="inputEmail" name="email" required>
                </div>

                <div class="col-md-12">
                  <label for="inputSubject">Your Subject</label>
                  <input type="text" class="form-control mt-2" id="inputSubject" name="subject">
                </div>

                <div class="col-md-12 mb-3">
                  <label for="inputTextarea">Your Message *</label>
                  <textarea class="form-control mt-2" id="inputTextarea" name="message" rows="4" required></textarea>
                </div>
              </div>

              <button class="btn btn-primary mt-3" type="submit">Send</button>
            </form>

            <!-- Success Message -->
            <div id="successMessage" class="alert alert-success mt-3" style="display:none;">
              ✅ Your message has been sent successfully!
            </div>
          </div>

          <!-- 📍 Contact Info -->
          <div class="col-sm-3 text-center">
            <ul class="list-unstyled">
              <li>
                <i class="fas fa-map-marker-alt fa-2x i-color"></i>
                <p>Lucknow, Uttar Pradesh, India</p>
              </li>
              <li>
                <i class="fas fa-phone-alt fa-2x i-color"></i>
                <p>+91 8303462756</p>
              </li>
              <li>
                <i class="fas fa-envelope mt-4 fa-2x i-color"></i>
                <p>vikashtrivedi230@gmail.com</p>
              </li>
            </ul>
          </div>
        </div>

        <!-- 📄 Download Resume Section -->
        <div class="text-center my-4">
          <a href="/Vikas-Trivedi-Resume.pdf" download class="btn btn-outline-warning btn-lg">
            <i class="fa fa-download"></i> Download My Resume
          </a>
          <p class="text-secondary mt-2 small">(PDF format, updated for 2025)</p>
        </div>

        <!-- 🔗 Social Links -->
        <div class="text-center my-5">
          <h3 class="text-warning mb-4 fw-bold">Connect With Me</h3>
          <div class="d-flex justify-content-center align-items-center flex-wrap gap-4">

            <!-- WhatsApp -->
            <a href="https://wa.me/918303462756" target="_blank"
               class="btn btn-outline-success rounded-circle d-flex align-items-center justify-content-center"
               style="width:60px; height:60px;">
              <i class="fab fa-whatsapp fa-lg"></i>
